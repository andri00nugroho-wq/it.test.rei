# Copy this file to .env.local for development or .env for Docker deployment.
# Replace every placeholder before exposing the service outside your computer.
# Set the admin email and password in this local file; never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-this-with-a-long-random-secret
APP_URL=https://ujian.example.com
DATA_DIR=./data